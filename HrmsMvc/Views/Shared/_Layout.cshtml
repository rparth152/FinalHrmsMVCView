        </button>
        <button class="topbar-collapse-btn d-flex d-md-none" onclick="openSidebar()" title="Menu">
            <i class="fa-solid fa-bars"></i>
        </button>

        <!-- Search -->
        <div class="topbar-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="globalSearch" placeholder="Search in Pulse360" autocomplete="off" />
            <span class="topbar-shortcut">CTRL + /</span>
        </div>

        <!-- Grid / Apps button -->
        <a class="topbar-icon-btn" href="#" title="Apps">
            <i class="fa-solid fa-grip"></i>
        </a>

        <!-- Settings -->
        <a class="topbar-icon-btn" asp-controller="Settings" asp-action="Index" title="Settings">
            <i class="fa-solid fa-gear"></i>
        </a>

        <div class="topbar-spacer"></div>

        <!-- Reload -->
        <button class="topbar-reload" onclick="window.location.reload()" title="Refresh">
            <i class="fa-solid fa-arrows-rotate"></i>
        </button>

        <!-- Avatar / Profile -->
        <div class="topbar-avatar" title="@User.Identity?.Name">
            @{
                var initials = User.Identity?.Name?.Length > 0
                ? User.Identity.Name.Substring(0, 1).ToUpper()
                : "U";
            }
            @initials
        </div>
    </div>

    <!-- ══════════════════════════════════════════
         MAIN CONTENT AREA
    ══════════════════════════════════════════ -->
    <div class="main-wrapper">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // ── Sidebar accordion toggle ──────────────────
        function toggleNav(btn) {
            const isOpen = btn.classList.contains('open');
            // Close all open groups
            document.querySelectorAll('.nav-group-toggle.open').forEach(b => {
                b.classList.remove('open');
                b.nextElementSibling?.classList.remove('open');
            });
            if (!isOpen) {
                btn.classList.add('open');
                btn.nextElementSibling?.classList.add('open');
            }
        }

        // ── Desktop sidebar collapse ──────────────────
        function toggleSidebarDesktop() {
            document.body.classList.toggle('sidebar-collapsed');
            localStorage.setItem('sidebarCollapsed', document.body.classList.contains('sidebar-collapsed'));
        }

        // Restore collapse state on load
        if (localStorage.getItem('sidebarCollapsed') === 'true') {
            document.body.classList.add('sidebar-collapsed');
        }

        // ── Mobile sidebar ────────────────────────────
        function openSidebar() {
            document.body.classList.add('sidebar-open');
        }

        function closeSidebar() {
            document.body.classList.remove('sidebar-open');
        }

        // ── Keyboard shortcut CTRL+/ for search ──────
        document.addEventListener('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.key === '/') {
                e.preventDefault();
                document.getElementById('globalSearch')?.focus();
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
